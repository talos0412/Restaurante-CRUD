@model PROYECTO_MONGO_DOTNET.Models.ViewModels.CategoriasPaginaVm
@{ ViewData["Title"] = "Categorías de gastos"; ViewData["ReporteEndpoint"] = "/Finanzas/Reportes/Categorias"; ViewData["ReporteTitulo"] = "Reporte de categorías de gastos"; ViewData["ReporteArchivo"] = "reporte_categorias"; }
<main class="crud-page"><section class="crud-titulo"><div><h2>Categorías de gastos</h2><p>Catálogo configurable para clasificar movimientos financieros.</p></div></section>
@if (Model.Mensaje != null) { <p class="mensaje-exito-general">Categoría guardada.</p> } @if (Model.Error != null) { <p class="mensaje-error-general">@Model.Error</p> }
<section class="crud-contenedor"><div class="crud-toolbar"><button class="btn-crud reporte" data-reporte-abrir>Reportes</button></div>
<div class="form-crud-box"><form method="post" action="/Finanzas/Categorias" class="form-grid-modulo">@Html.AntiForgeryToken()<div class="grupo-campo"><label>Nombre</label><input name="Nombre" required></div><div class="grupo-campo"><label>Descripción</label><input name="Descripcion"></div><input type="hidden" name="Activo" value="true"><button class="btn-crud verde">Guardar categoría</button></form></div>
<div class="tabla-contenedor tabla-clara"><table class="tabla-crud"><thead><tr><th>Código</th><th>Nombre</th><th>Descripción</th><th>Activo</th></tr></thead><tbody>@foreach (var x in Model.Categorias) { <tr><td>@x.CodigoCategoria</td><td>@x.Nombre</td><td>@x.Descripcion</td><td>@(x.Activo ? "Sí" : "No")</td></tr> } @if (!Model.Categorias.Any()) { <tr><td colspan="4" class="tabla-vacia">No existen categorías.</td></tr> }</tbody></table></div></section><partial name="~/Views/Shared/Reportes/_ModalReporte.cshtml" /></main>
@section Scripts { <script src="/js/reportes-parametrizados.js?v=20260720" defer></script> }
