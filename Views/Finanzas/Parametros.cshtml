@model PROYECTO_MONGO_DOTNET.Models.ViewModels.ParametrosPaginaVm
@{ ViewData["Title"] = "Parámetros financieros"; ViewData["ReporteEndpoint"] = "/Finanzas/Reportes/Parametros"; ViewData["ReporteTitulo"] = "Reporte de parámetros financieros"; ViewData["ReporteArchivo"] = "reporte_parametros"; }
<main class="crud-page"><section class="crud-titulo"><div><h2>Parámetros financieros</h2><p>Valores configurables usados por costos y control presupuestario.</p></div></section>
@if (Model.Mensaje != null) { <p class="mensaje-exito-general">Parámetro guardado.</p> } @if (Model.Error != null) { <p class="mensaje-error-general">@Model.Error</p> }
<section class="crud-contenedor"><div class="crud-toolbar"><button class="btn-crud reporte" data-reporte-abrir>Reportes</button></div>
<div class="form-crud-box"><form method="post" action="/Finanzas/Parametros" class="form-grid-modulo">@Html.AntiForgeryToken()<div class="grupo-campo"><label>Código</label><input name="CodigoParametro" required></div><div class="grupo-campo"><label>Descripción</label><input name="Descripcion" required></div><div class="grupo-campo"><label>Tipo</label><select name="TipoDato"><option>TEXTO</option><option>DECIMAL</option><option>ENTERO</option></select></div><div class="grupo-campo"><label>Valor texto</label><input name="ValorTexto"></div><div class="grupo-campo"><label>Valor decimal</label><input name="ValorDecimal" type="number" step="0.01"></div><div class="grupo-campo"><label>Valor entero</label><input name="ValorEntero" type="number"></div><input type="hidden" name="Activo" value="true"><button class="btn-crud verde">Guardar parámetro</button></form></div>
<div class="tabla-contenedor tabla-clara"><table class="tabla-crud"><thead><tr><th>Código</th><th>Descripción</th><th>Tipo</th><th>Valor</th><th>Activo</th></tr></thead><tbody>@foreach (var x in Model.Parametros) { <tr><td>@x.CodigoParametro</td><td>@x.Descripcion</td><td>@x.TipoDato</td><td>@(x.ValorTexto ?? x.ValorDecimal?.ToString() ?? x.ValorEntero?.ToString())</td><td>@(x.Activo ? "Sí" : "No")</td></tr> } @if (!Model.Parametros.Any()) { <tr><td colspan="5" class="tabla-vacia">No existen parámetros.</td></tr> }</tbody></table></div></section><partial name="~/Views/Shared/Reportes/_ModalReporte.cshtml" /></main>
@section Scripts { <script src="/js/reportes-parametrizados.js?v=20260720" defer></script> }
