@model PROYECTO_MONGO_DOTNET.Models.ViewModels.MovimientosPaginaVm
@{ ViewData["Title"] = Model.ModoAprobacion ? "Aprobar o rechazar gastos" : "Gastos de proyectos"; ViewData["ReporteEndpoint"] = "/Finanzas/Reportes/Gastos"; ViewData["ReporteTitulo"] = "Reporte parametrizado de gastos"; ViewData["ReporteArchivo"] = "reporte_gastos"; }
<main class="crud-page"><section class="crud-titulo"><div><h2>@ViewData["Title"]</h2><p>Solo los gastos aprobados afectan el control presupuestario.</p></div></section>
@if (Model.Mensaje != null) { <p class="mensaje-exito-general">Operación completada.</p> } @if (Model.Error != null) { <p class="mensaje-error-general">@Model.Error</p> }
<section class="crud-contenedor"><div class="crud-toolbar"><button class="btn-crud reporte" data-reporte-abrir>Reportes</button></div>
@if (!Model.ModoAprobacion) { <div class="form-crud-box"><form method="post" action="/Finanzas/Gastos" class="form-grid-modulo">@Html.AntiForgeryToken()<div class="grupo-campo"><label>Proyecto</label><select name="CodigoProyecto" required><option value="">Seleccione...</option>@foreach (var x in Model.Proyectos) { <option value="@x.Codigo">@x.Nombre</option> }</select></div><div class="grupo-campo"><label>Categoría</label><select name="CodigoCategoria" required><option value="">Seleccione...</option>@foreach (var x in Model.Categorias.Where(x => x.Activo)) { <option value="@x.CodigoCategoria">@x.Nombre</option> }</select></div><input type="hidden" name="Tipo" value="GASTO"><div class="grupo-campo"><label>Concepto</label><input name="Concepto" required></div><div class="grupo-campo"><label>Valor</label><input name="Valor" type="number" min="0.01" step="0.01" required></div><div class="grupo-campo"><label>Fecha</label><input name="Fecha" type="date" required></div><div class="grupo-campo"><label>Observación</label><input name="Observacion"></div><button class="btn-crud verde">Registrar gasto</button></form></div> }
<div class="tabla-contenedor tabla-clara"><table class="tabla-crud"><thead><tr><th>Código</th><th>Proyecto</th><th>Categoría</th><th>Concepto</th><th>Valor</th><th>Fecha</th><th>Estado</th><th>Operaciones</th></tr></thead><tbody>
@foreach (var x in Model.Movimientos) { <tr><td>@x.CodigoMovimiento</td><td>@x.CodigoProyecto</td><td>@x.CodigoCategoria</td><td>@x.Concepto</td><td>@x.Valor.ToString("N2")</td><td>@x.Fecha.ToString("yyyy-MM-dd")</td><td>@x.Estado</td><td>@if (Model.ModoAprobacion && x.Estado == "PENDIENTE") { <div class="acciones-form"><form method="post" action="/Finanzas/AprobarGastos/@x.CodigoMovimiento/APROBADO">@Html.AntiForgeryToken()<button class="btn-accion-texto accion-ver">Aprobar</button></form><form method="post" action="/Finanzas/AprobarGastos/@x.CodigoMovimiento/RECHAZADO">@Html.AntiForgeryToken()<button class="btn-accion-texto accion-eliminar">Rechazar</button></form></div> }</td></tr> }
@if (!Model.Movimientos.Any()) { <tr><td colspan="8" class="tabla-vacia">No existen movimientos.</td></tr> }
</tbody></table></div></section><partial name="~/Views/Shared/Reportes/_ModalReporte.cshtml" /></main>
@section Scripts { <script src="/js/reportes-parametrizados.js?v=20260720" defer></script> }
