<dialog class="proyecto-modal" data-modal-cierre><form class="proyecto-modal-contenido" data-form-cierre><header><div><small>Finalización del proyecto</small><h3 data-cierre-titulo>Finalizar proyecto</h3><p>El sistema comprobará la cobertura, tareas, actividades y entregables.</p></div><button type="button" class="modal-cerrar" data-cerrar-modal aria-label="Cerrar">×</button></header><div class="proyecto-modal-cuerpo"><div class="validacion-cierre" data-validacion-cierre></div><div class="proyecto-form-grid"><div class="grupo-campo"><label for="fechaFinReal">Fecha real de finalización</label><input id="fechaFinReal" name="fechaFinReal" type="date" required></div><div class="grupo-campo campo-ancho"><label for="observacionFinal">Observación final</label><textarea id="observacionFinal" name="observacionFinal" maxlength="1000" rows="4" required></textarea></div></div></div><footer><button type="button" class="btn-crud celeste" data-cerrar-modal>Volver</button><button type="submit" class="btn-crud verde" data-confirmar-finalizacion>Finalizar proyecto</button></footer></form></dialog>
