<section class="visualizacion-proyecto"><header class="visualizacion-toolbar"><div><h3>Calendario</h3><p>Consulte el trabajo por mes, semana o como lista ordenada.</p></div><div class="visualizacion-controles"><button type="button" class="btn-crud celeste" data-cal-anterior>Anterior</button><button type="button" class="btn-crud celeste" data-cal-hoy>Hoy</button><button type="button" class="btn-crud celeste" data-cal-siguiente>Siguiente</button><div class="control-segmentado"><button type="button" class="activo" data-cal-vista="mes">Mes</button><button type="button" data-cal-vista="semana">Semana</button><button type="button" data-cal-vista="lista">Lista</button></div><button type="button" class="btn-crud" data-cal-filtros>Filtros</button></div></header><h4 class="calendario-periodo" data-cal-periodo></h4><div data-calendario-grafico></div></section>
<dialog class="proyecto-modal proyecto-modal-sm" data-modal-filtros-calendario><form class="proyecto-modal-contenido" data-form-filtros-calendario><header><div><small>Calendario</small><h3>Filtrar elementos</h3></div><button type="button" class="modal-cerrar" data-cerrar-modal>×</button></header><div class="proyecto-modal-cuerpo proyecto-form-grid"><div class="grupo-campo"><label>Responsable</label><select name="responsable"><option value="">Todos</option></select></div><div class="grupo-campo"><label>Fase</label><select name="fase"><option value="">Todas</option></select></div><div class="grupo-campo"><label>Estado</label><select name="estado"><option value="">Todos</option><option value="PENDIENTE">Pendiente</option><option value="EN_PROCESO">En progreso</option><option value="COMPLETADA">Completada</option></select></div><div class="grupo-campo"><label>Tipo</label><select name="tipo"><option value="">Todos</option><option value="ACTIVIDAD">Actividad</option><option value="TAREA">Tarea</option><option value="ENTREGABLE">Entregable</option></select></div><label class="filtro-check"><input type="checkbox" name="atrasadas"> Solo atrasadas</label><label class="filtro-check"><input type="checkbox" name="proximas"> Solo próximas a vencer</label></div><footer><button type="reset" class="btn-crud celeste">Limpiar</button><button type="submit" class="btn-crud verde">Aplicar filtros</button></footer></form></dialog>
