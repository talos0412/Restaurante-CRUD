@model PROYECTO_MONGO_DOTNET.Models.ViewModels.ProyectosPaginaVm
<dialog class="proyecto-modal" data-modal-asignacion><form class="proyecto-modal-contenido" data-form-asignacion novalidate><header><div><small>Equipo del proyecto</small><h3 data-asignacion-titulo>Asignar integrante</h3><p>La disponibilidad se valida contra otros proyectos activos con fechas coincidentes.</p></div><button type="button" class="modal-cerrar" data-cerrar-modal aria-label="Cerrar">×</button></header><div class="proyecto-modal-cuerpo proyecto-form-grid"><div class="grupo-campo"><label for="asignacionEmpleado">Empleado <span aria-hidden="true">*</span></label><select id="asignacionEmpleado" name="codigoEmpleado" required><option value="">Seleccione...</option>@foreach (var e in Model.Empleados) { <option value="@e.PeempCodigo">@e.Persona.Nombres @e.Persona.Apellidos</option> }</select><small>Solo empleados con usuario activo.</small><span class="campo-error" data-error="codigoEmpleado"></span></div><div class="grupo-campo"><label for="asignacionRol">Rol dentro del proyecto <span aria-hidden="true">*</span></label><input id="asignacionRol" name="rol" maxlength="100" required><span class="campo-error" data-error="rol"></span></div><div class="grupo-campo"><label for="asignacionDisponibilidad">Disponibilidad asignada al proyecto</label><select id="asignacionDisponibilidad" name="disponibilidadAsignada"><option value="25">25 % — Apoyo ocasional</option><option value="50">50 % — Media dedicación</option><option value="75">75 % — Participación principal</option><option value="100">100 % — Dedicación completa</option></select><small>Porcentaje de capacidad que el empleado reserva durante estas fechas.</small><span class="campo-error" data-error="disponibilidadAsignada"></span></div><div class="grupo-campo"><label for="asignacionInicio">Fecha inicial <span aria-hidden="true">*</span></label><input id="asignacionInicio" name="fechaInicio" type="date" required><span class="campo-error" data-error="fechaInicio"></span></div><div class="grupo-campo"><label for="asignacionFin">Fecha final <span aria-hidden="true">*</span></label><input id="asignacionFin" name="fechaFin" type="date" required><span class="campo-error" data-error="fechaFin"></span></div><div class="grupo-campo campo-ancho"><label for="asignacionObservacion">Observación</label><textarea id="asignacionObservacion" name="observacion" maxlength="500" rows="2"></textarea></div><div class="campo-ancho disponibilidad-ayuda" data-disponibilidad-ayuda></div></div><footer><button type="button" class="btn-crud celeste" data-cerrar-modal>Cancelar</button><button type="submit" class="btn-crud verde" data-guardar-asignacion>Guardar integrante</button></footer></form></dialog>
