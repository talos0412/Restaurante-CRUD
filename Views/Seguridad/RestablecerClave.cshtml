@model RestablecerClavePaginaVm
@{ ViewData["Title"] = "Restablecer contraseña"; }
<main class="crud-page">
    <section class="crud-titulo"><div><h2>Restablecer contraseña</h2><p>Desbloquea al usuario y obliga el cambio de contraseña en el próximo ingreso.</p></div></section>
    @if (Model.Mensaje == "restablecida") { <p class="mensaje-exito-general">Contraseña temporal asignada correctamente.</p> }
    @if (!string.IsNullOrWhiteSpace(Model.Error)) { <p class="mensaje-error-general">@Model.Error</p> }
    <section class="crud-contenedor">
        <div class="form-crud-box">
            <form method="post" action="/RestablecerClaveController" class="form-grid-modulo">
                @Html.AntiForgeryToken()
                <div class="grupo-campo">
                    <label for="loginRestablecer">Usuario</label>
                    <select id="loginRestablecer" name="Login" required>
                        <option value="">Seleccione...</option>
                        @foreach (var usuario in Model.Usuarios)
                        {
                            <option value="@usuario.Login" selected="@(Model.LoginSeleccionado == usuario.Login ? "selected" : null)">@usuario.Login - @(string.IsNullOrWhiteSpace(usuario.NombrePersona) ? "Sin nombre" : usuario.NombrePersona)</option>
                        }
                    </select>
                </div>
                <div class="grupo-campo"><label>Contraseña temporal</label><input name="ClaveTemporal" type="password" autocomplete="new-password" required></div>
                <div class="grupo-campo"><label>Confirmación</label><input name="Confirmacion" type="password" autocomplete="new-password" required></div>
                <p class="campo-ancho campo-ayuda">Debe tener entre 8 y 128 caracteres e incluir mayúscula, minúscula, número y símbolo.</p>
                <div class="campo-ancho busqueda-acciones"><button class="btn-crud verde" type="submit">Restablecer contraseña</button><a class="btn-crud celeste" href="/UsuarioController">Volver a usuarios</a></div>
            </form>
        </div>
    </section>
</main>
